# Copie este arquivo para .env.local e preencha os valores.
# Nunca commite .env.local nem tokens reais.

# URL pública do site (usada em links internos e no painel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Senha do painel administrativo (obrigatória em produção)
ADMIN_PASSWORD=altere-esta-senha

# Segredo para assinar o cookie de sessão. Use pelo menos 32 caracteres aleatórios.
ADMIN_SESSION_SECRET=substitua-por-32-caracteres-aleatorios

# E-mail de contato do responsável pelo tratamento de dados (aparece na Política de Privacidade)
PRIVACY_CONTACT_EMAIL=preencher@exemplo.com

# Nome do responsável pelo tratamento (pessoa física ou razão social)
PRIVACY_CONTROLLER_NAME=Professor Nickolas Amaral

# Prazo de retenção das avaliações, em dias. Deixe vazio para exibir "prazo a definir".
RETENTION_DAYS=

# WhatsApp Business Platform / Cloud API
# O número de DESTINO do professor NÃO é o remetente da API.
# Informe o Phone Number ID do número remetente cadastrado na Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Destino das avaliações (somente dígitos, formato internacional)
WHATSAPP_DESTINATION=5522997231553

# Token de verificação do webhook (o mesmo informado no App da Meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Banco local (SQLite via libSQL). Em produção com Supabase, veja README.
DATABASE_URL=file:./data/avaliacoes.db

# Opcional: Supabase (Postgres + Storage privado + Auth do admin)
# Se SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY estiverem preenchidos, o app usa o Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Identificação profissional — preenchida também no painel
NEXT_PUBLIC_CREF=
NEXT_PUBLIC_PHOTO_URL=
